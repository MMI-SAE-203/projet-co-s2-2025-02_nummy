---
import Layout from "../../layouts/Layout.astro";
import { getEtablissementById, pb } from "../../js/backend.js";
import { isLoggedIn, initAuthentication } from "../../js/login.js";

const { id } = Astro.params;

const response = await getEtablissementById(id);
const establishment = response.success ? response.item : null;

const otherEstablishments = await pb.collection("Etablissement").getList(1, 8, {
  filter: `id != "${id}"`,
});

export async function getStaticPaths() {
  const { items } = await pb.collection("Etablissement").getList(1, 100);

  return items.map((establishment) => ({
    params: { id: establishment.id },
  }));
}

if (!establishment) {
  return Astro.redirect("/restaurants");
}

initAuthentication();
const isAuthenticated = isLoggedIn();

const imageUrl = establishment.image_etablissement
  ? `https://nummy.arthurwicky.fr/api/files/Etablissement/${establishment.id}/${establishment.image_etablissement}`
  : "https://via.placeholder.com/800x400?text=Nummy";
---

<Layout
  classBody="colorNav"
  classBody="colorPage colorNav"
  title={`${establishment.nom_etablissement} | Nummy`}
>
  <div class="relative">
    <!-- Mobile Header Image -->
    <div class="block md:hidden">
      <div class="relative h-64 w-full mt-25">
        <img
          src={imageUrl}
          alt={establishment.nom_etablissement}
          class="w-full h-full object-cover"
        />

        <a
          href="/restaurants"
          class="absolute top-4 left-4 bg-[var(--color-orange)] bg-opacity-50 text-white p-2 rounded-full hover:bg-opacity-70 transition-all"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path>
          </svg>
        </a>

        {
          establishment.partenariat_etablissement && (
            <div class="button absolute top-4 right-4 bg-[var(--color-orange)] text-white px-3 py-1 rounded-full font-medium">
              PARTENAIRE
            </div>
          )
        }

        {
          (
            // isAuthenticated && (
            <button
              id="favorite-btn-mobile"
              class="absolute bottom-4 right-4 bg-white p-3 rounded-full shadow-lg hover:shadow-xl transition-all favorite-btn"
              data-id={establishment.id}
              data-favorite={establishment.Favori_etablissement}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-gray-600"
                fill={establishment.Favori_etablissement ? "#FF8C42" : "none"}
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                />
              </svg>
            </button>
          )
        }
      </div>
    </div>

    <!-- Desktop Header -->
    <div class="hidden md:block pt-20">
      <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
          <a
            href="/restaurants"
            class="text-[var(--color-orange)] hover:underline flex items-center text-sm"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 mr-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
            </svg>
            Retour à la page précédent
          </a>
        </div>

        <div class="grid grid-cols-11 gap-5">
          <div class="col-span-6">
            <div class="relative h-96 rounded-lg overflow-hidden shadow-lg">
              <img
                src={imageUrl}
                alt={establishment.nom_etablissement}
                class="w-full h-full object-cover"
              />

              {
                establishment.partenariat_etablissement && (
                  <div class="absolute top-4 right-4 bg-[var(--color-orange)] text-white px-4 py-2 rounded-full text-sm font-medium">
                    PARTENAIRE
                  </div>
                )
              }

              {
                (
                  <button
                    id="favorite-btn-desktop"
                    class="absolute bottom-4 right-4 bg-white p-3 rounded-full shadow-lg hover:shadow-xl transition-all favorite-btn"
                    data-id={establishment.id}
                    data-favorite={establishment.Favori_etablissement}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-6 w-6 text-[var(--color-vert)]"
                      fill={
                        establishment.Favori_etablissement ? "#FF8C42" : "none"
                      }
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                      />
                    </svg>
                  </button>
                )
              }
            </div>
          </div>

          <div class="col-span-5 space-y-6 lg:pt-30">
            <div>
              <div
                class="flex items-center text-sm text-[var(--color-green)] mb-2"
              >
                <span class="font-medium"
                  >{establishment.continent_etablissement}</span
                >
                <span class="mx-2">|</span>
                <span>{establishment.categorie_etablissement}</span>
              </div>
              <h1 class="text-6xl font-bold text-gray-900 mb-4">
                {establishment.nom_etablissement}
              </h1>

              {
                establishment.site_etablissement && (
                  <a
                    href={establishment.site_etablissement}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block bg-[var(--color-green)] text-white px-6 py-2 my-2 rounded-md hover:bg-opacity-90 transition-colors"
                  >
                    VISITER LE SITE
                  </a>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white">
    <div class="container mx-auto px-4 py-6 md:py-8">
      <div class="block md:hidden mb-6 items-center justify-center">
        <div
          class="p-body2 flex text-sm text-black mb-2 text-center items-center justify-center"
        >
          <span class="flex font-medium"
            >{establishment.continent_etablissement}</span
          >
          <span class="mx-2 text-center items-center">|</span>
          <span>{establishment.categorie_etablissement}</span>
        </div>
        <h1
          class="text-4xl font-bold text-gray-900 mb-4 text-center items-center"
        >
          {establishment.nom_etablissement}
        </h1>
        {
          establishment.site_etablissement && (
            <a
              href={establishment.site_etablissement}
              target="_blank"
              rel="noopener noreferrer"
              class="flex button bg-[var(--color-green)] text-white px-8 py-4 rounded-4xl hover:bg-opacity-90 transition-colors text-sm w-50 mx-auto justify-center items-center text-center"
            >
              VISITER LE SITE
            </a>
          )
        }
      </div>

      <!-- Desktop Content Layout -->
      <div class="hidden md:block">
        <div class="grid grid-cols-11 gap-6">
          <div class=" col-span-6">
            <h2
              class="h3-header text-gray-900 mb-4 border-b-6 border-[var(--color-orange)] pb-2 inline-block"
            >
              Localisation
            </h2>

            <div class="mb-4">
              <h3 class="font-semibold text-gray-900 mb-2">Adresse</h3>
              <p class="text-black establishment-address">
                {establishment.adresse_etablissement}
              </p>
              <p class="text-black establishment-city">
                {establishment.ville_etablissement}
              </p>
            </div>

            <div
              class="map-container h-80 w-full rounded-lg shadow-lg relative z-10"
              data-latitude={establishment.latitude}
              data-longitude={establishment.longitude}
              data-name={establishment.nom_etablissement}
            >
            </div>
          </div>

          <!-- Right Column -->
          <div class="col-span-5 space-y-8">
            <div>
              <h2
                class="h3-header font-bold text-gray-900 mb-4 border-b-2 border-[#FF8C42] pb-2 inline-block"
              >
                Information
              </h2>
              <div class="prose max-w-none text-black leading-relaxed">
                <div set:html={establishment.infos_etablissement} />
              </div>
            </div>

            <div>
              <h2
                class="h3-header text-gray-900 mb-4 border-b-2 border-[#FF8C42] pb-2 inline-block"
              >
                Horaires
              </h2>
              <div class="bg-[var(--color-orange)] text-black p-4 lg:py-10 rounded-lg justify-center items-center text-center">
                <div class="space-y-2 text-sm *:py-3">
                  <div class="flex justify-between">
                    <span class="font-medium">Lundi à Vendredi</span>
                    <span>De 8h00 à 20h00</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-medium">Samedi et dimanches</span>
                    <span>De 9h00 à 17h00</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-medium">Jours fériés</span>
                    <span>Fermé</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile Content Layout -->
      <div class="block md:hidden">
        <div class="mb-8">
          <h2
            class="h3-header pt-6 text-gray-900 mb-4 border-b-2 border-[#FF8C42] pb-2 inline-block"
          >
            Information
          </h2>
          <div class="p-body2 prose max-w-none text-black leading-relaxed">
            <div set:html={establishment.infos_etablissement} />
          </div>
        </div>

        <div class="mb-8">
          <h2
            class="h3-header text-gray-900 mb-4 border-b-2 border-[var(--color-orange)] pb-2 inline-block"
          >
            Horaires
          </h2>
          <div class="bg-[var(--color-orange)] text-black font-medium p-body2 px-4 py-6 rounded-lg">
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="font-medium">Lundi à Vendredi</span>
                <span>De 8h00 à 20h00</span>
              </div>
              <div class="flex justify-between">
                <span class="font-medium">Samedi et dimanches</span>
                <span>De 9h00 à 17h00</span>
              </div>
              <div class="flex justify-between">
                <span class="font-medium">Jours fériés</span>
                <span>Fermé</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mb-8">
          <h2
            class="h3-header text-gray-900 mb-4 border-b-6 border-[var(--color-orange)] pb-2 inline-block"
          >
            Localisation
          </h2>

          <div class="flex mb-4 items-center justify-center gap-5">
            <h3 class="font-semibold text-gray-900 mb-2">Adresse</h3>
            <p class="text-black establishment-address">
              {establishment.adresse_etablissement}
            </p>
          </div>

          <div
            class="map-container h-64 md:h-80 w-full rounded-lg shadow-lg relative z-10"
            data-latitude={establishment.latitude}
            data-longitude={establishment.longitude}
            data-name={establishment.nom_etablissement}
          >
          </div>
        </div>
      </div>

      <!-- (carousel) -->
      <div class="mb-8 mt-10">
        <h2
          class="h3-header text-gray-900 mb-6 border-b-6 border-[var(--color-orange)] pb-2 inline-block"
        >
          Autres restaurants
        </h2>

        <div class="carousel-wrapper relative">
          <div class="carousel-container overflow-hidden">
            <div class="carousel-track flex">
              {
                otherEstablishments.items.map((item) => {
                  const itemImageUrl = item.image_etablissement
                    ? `https://nummy.arthurwicky.fr/api/files/Etablissement/${item.id}/${item.image_etablissement}`
                    : "https://via.placeholder.com/300x200?text=Nummy";

                  return (
                    <div class="carousel-item w-full md:w-1/3 flex-shrink-0 px-2">
                      <a
                        href={`/restaurants/${item.id}`}
                        class="block bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow overflow-hidden h-full"
                      >
                        <div class="relative h-48">
                          <img
                            src={itemImageUrl}
                            alt={item.nom_etablissement}
                            class="w-full h-full object-cover"
                          />
                          {item.partenariat_etablissement && (
                            <div class="absolute top-2 right-2 bg-[#FF8C42] text-white px-2 py-1 rounded text-xs font-medium">
                              PARTENAIRE
                            </div>
                          )}
                        </div>
                        <div class="p-4">
                          <div class="flex items-center text-xs text-gray-600 mb-1">
                            <span>{item.categorie_etablissement}</span>
                            <span class="mx-1">|</span>
                            <span>{item.continent_etablissement}</span>
                          </div>
                          <h3 class="font-semibold text-gray-900 text-sm mb-2 line-clamp-2">
                            {item.nom_etablissement}
                          </h3>
                        </div>
                      </a>
                    </div>
                  );
                })
              }
            </div>
          </div>

          <button
            class="carousel-prev absolute left-2 top-1/2 transform -translate-y-1/2 bg-[#FF8C42] text-white p-2 rounded-full shadow-lg hover:bg-opacity-90 z-10"
            aria-label="Précédent"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              stroke="currentColor"
              fill="none"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>
          <button
            class="carousel-next absolute right-2 top-1/2 transform -translate-y-1/2 bg-[#FF8C42] text-white p-2 rounded-full shadow-lg hover:bg-opacity-90 z-10"
            aria-label="Suivant"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              stroke="currentColor"
              fill="none"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>

<script>
  import { toggleFavorite, isLoggedIn } from "../../js/backend.js";

  document.addEventListener("DOMContentLoaded", () => {
    initializeMaps();
    initializeFavoriteButtons();
    initializeCarousel();
  });

  function initializeMaps() {
    console.log("Inicializando mapas...");
    const mapContainers = document.querySelectorAll(".map-container");

    mapContainers.forEach((container) => {
      const lat = parseFloat(container.dataset.latitude);
      const lng = parseFloat(container.dataset.longitude);
      const name = container.dataset.name;

      console.log(`Coordonnées pour ${name}: lat=${lat}, lng=${lng}`);

      if (lat && lng && !isNaN(lat) && !isNaN(lng)) {
        const map = L.map(container, {
          zoomControl: true,
          scrollWheelZoom: false,
        }).setView([lat, lng], 15);

        console.log("Carte créée");

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          attribution:
            '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          maxZoom: 19,
        }).addTo(map);

        const addressElement = container
          .closest("div")
          .querySelector(".establishment-address");
        const cityElement = container
          .closest("div")
          .querySelector(".establishment-city");

        const address = addressElement ? addressElement.textContent.trim() : "";
        const city = cityElement ? cityElement.textContent.trim() : "";

        console.log(`Adresse: ${address}, ${city}`);

        const marker = L.marker([lat, lng]).addTo(map);

        marker
          .bindPopup(
            `
        <strong>${name}</strong>
        ${address ? `<br>${address}` : ""}
        ${city ? `<br>${city}` : ""}
      `
          )
          .openPopup();

        setTimeout(() => {
          console.log("demarrage de la carte");
          map.invalidateSize();
        }, 300);
      } else {
        console.error("adresse ou coordonnées invalides pour l'établissement:");
        container.innerHTML = `
        <div class="flex items-center justify-center h-full bg-gray-100 rounded-lg">
          <p class="text-gray-500">Carte non disponible pour cet établissement.</p>
        </div>
      `;
      }
    });
  }

  function initializeFavoriteButtons() {
    const favoriteButtons = document.querySelectorAll(".favorite-btn");

    if (favoriteButtons.length && isLoggedIn()) {
      favoriteButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          const establishmentId = button.dataset.id;
          const currentlyFavorite = button.dataset.favorite === "true";

          const icon = button.querySelector("svg");
          if (icon) {
            icon.setAttribute("fill", currentlyFavorite ? "none" : "#FF8C42");
          }

          try {
            const response = await toggleFavorite(
              establishmentId,
              !currentlyFavorite
            );
            if (response.success) {
              document
                .querySelectorAll(`.favorite-btn[data-id="${establishmentId}"]`)
                .forEach((btn) => {
                  btn.dataset.favorite = (!currentlyFavorite).toString();
                });
            } else {
              if (icon) {
                icon.setAttribute(
                  "fill",
                  currentlyFavorite ? "#FF8C42" : "none"
                );
              }
              if (response.error && response.error.includes("connecté")) {
                alert(
                  "Veuillez vous connecter pour ajouter cet établissement à vos favoris."
                );
              }
            }
          } catch (error) {
            console.error("Erreur lors de la mise à jour du favori:", error);
            if (icon) {
              icon.setAttribute("fill", currentlyFavorite ? "#FF8C42" : "none");
            }
          }
        });
      });
    }
  }

  function initializeCarousel() {
    const container = document.querySelector(".carousel-container");
    const prevBtn = document.querySelector(".carousel-prev");
    const nextBtn = document.querySelector(".carousel-next");

    if (!container || !prevBtn || !nextBtn) {
      console.error("Elementos del carrusel no encontrados");
      return;
    }

    prevBtn.addEventListener("click", () => {
      container.scrollBy({ left: -container.clientWidth, behavior: "smooth" });
    });

    nextBtn.addEventListener("click", () => {
      container.scrollBy({ left: container.clientWidth, behavior: "smooth" });
    });

    function updateButtons() {
      prevBtn.disabled = container.scrollLeft <= 0;
      nextBtn.disabled =
        container.scrollLeft + container.clientWidth >= container.scrollWidth;
    }

    container.addEventListener("scroll", updateButtons);
    window.addEventListener("resize", updateButtons);

    // Estado inicial
    updateButtons();
  }

  document.addEventListener("DOMContentLoaded", () => {
    initializeMaps();
    initializeFavoriteButtons();
    initializeCarousel();
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .map-container {
    position: relative;
    z-index: 1;
  }

  .grid-cols-11 {
    grid-template-columns: repeat(11, minmax(0, 1fr));
  }

  .col-span-5 {
    grid-column: span 5 / span 5;
  }

  .col-span-6 {
    grid-column: span 6 / span 6;
  }

  .carousel-container {
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  .carousel-container {
    scroll-snap-type: x mandatory;
  }
  .carousel-item {
    scroll-snap-align: start;
  }
</style>
