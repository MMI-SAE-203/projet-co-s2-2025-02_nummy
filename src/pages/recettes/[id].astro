---
import Layout from "../../layouts/Layout.astro";
import {
  getAllRecettes,
  getRecetteById,
  getAvisByRecette,
  getAvisStats,
} from "../../js/backend.js";

// Interface pour TypeScript
interface Recette {
  id: string;
  nom_recette: string;
  hero_recette?: string;
  pays_recette: string;
  continent_recette: string;
  personnes_recette: number;
  temps_recette: number;
  ingredients_recette: string;
  produits_recette?: any[];
  images_recette?: string[];
  preparation_recette: string;
  favori: boolean;
  utilisateur_recette?: any;
  created: string;
}

export async function getStaticPaths() {
  try {
    const allRecettes = await getAllRecettes();
    return allRecettes.map((recette) => ({
      params: { id: recette.id },
      props: { recette },
    }));
  } catch (error) {
    console.error("Error en getStaticPaths:", error);
    return [{ params: { id: "fallback" } }];
  }
}

const { id } = Astro.params;
const { recette } = Astro.props;
let recetteData = recette;

if (!recetteData) {
  try {
    const result = await getRecetteById(id);
    if (result.success && result.item) {
      recetteData = result.item;
    } else {
      return Astro.redirect("/recettes");
    }
  } catch (error) {
    console.error("Error al obtener la recette:", error);
    return Astro.redirect("/recettes");
  }
}

if (id === "fallback") {
  return Astro.redirect("/recettes");
}

const heroUrl = recetteData.hero_recette
  ? `https://nummy.arthurwicky.fr/api/files/Recette/${recetteData.id}/${recetteData.hero_recette}`
  : "https://via.placeholder.com/800x400?text=Recette";

let recettesSimilaires: Recette[] = [];
try {
  const allRecettes = await getAllRecettes();
  recettesSimilaires = allRecettes
    .filter(
      (r) =>
        r.id !== recetteData.id &&
        r.continent_recette === recetteData.continent_recette
    )
    .slice(0, 3);
} catch (error) {
  console.error("Error al obtener recettes similaires:", error);
}

function stripHtml(html: string): string {
  if (!html) return "";
  return html
    .replace(/<[^>]*>/g, "")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&nbsp;/g, " ")
    .trim();
}

let avisList = [];
let avisStats = {
  total: 0,
  moyenne: 0,
  repartition: { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 },
};

try {
  const avisResponse = await getAvisByRecette(recetteData.id);
  const statsResponse = await getAvisStats(recetteData.id);

  if (avisResponse.success) {
    avisList = avisResponse.items;
  }

  if (statsResponse.success) {
    avisStats = statsResponse;
  }
} catch (error) {
  console.error("Error loading avis:", error);
}
---

<Layout
  classBody="colorPage colorNav"
  title={`${recetteData.nom_recette} | Nummy`}
>
  <!-- Section principale -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-24">
    <div class="bg-[var(--color-blanc)] rounded-xl shadow-lg overflow-hidden">
      <div class="md:flex">
        <!-- Image hero -->
        <div class="md:flex-shrink-0 md:w-1/2">
          <img
            src={heroUrl}
            loading="lazy"
            alt={recetteData.nom_recette}
            class="h-full w-full object-cover md:h-full md:w-full max-h-[500px]"
            onerror="this.onerror=null; this.src='https://via.placeholder.com/800x400?text=Recette';"
          />
        </div>

        <!-- Info principales -->
        <div class="p-8 md:w-1/2">
          <div class="flex items-center flex-wrap gap-2">
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-[var(--color-green)] bg-opacity-20 text-white mr-2"
            >
              {recetteData.continent_recette}
            </span>
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-[var(--color-bleu)] bg-opacity-20 text-white"
            >
              {recetteData.pays_recette}
            </span>
            {
              recetteData.favori && (
                <span class="ml-auto text-[var(--color-orange)] text-2xl">
                  ★ Favori
                </span>
              )
            }
          </div>

          <h1
            class="mt-4 text-3xl text-[var(--color-noir)] tracking-wide h1-header"
          >
            {recetteData.nom_recette}
          </h1>

          <!-- Informations pratiques -->
          <div class="mt-6 grid grid-cols-2 gap-4">
            <div class="bg-[var(--color-lin)] p-4 rounded-lg text-center">
              <div class="text-2xl mb-2">👥</div>
              <div class="p-body2 font-bold text-[var(--color-noir)]">
                {recetteData.personnes_recette}
              </div>
              <div class="p-body3 text-[var(--color-green)]">Personnes</div>
            </div>
            <div class="bg-[var(--color-lin)] p-4 rounded-lg text-center">
              <div class="text-2xl mb-2">⏱️</div>
              <div class="p-body2 font-bold text-[var(--color-noir)]">
                {recetteData.temps_recette} min
              </div>
              <div class="p-body3 text-[var(--color-green)]">Préparation</div>
            </div>
          </div>

          <!-- Produits utilisés -->
          {
            recetteData.produits_recette &&
              recetteData.produits_recette.length > 0 && (
                <div class="mt-6">
                  <h3 class="p-body1 font-bold mb-3 text-[var(--color-noir)]">
                    Produits utilisés:
                  </h3>
                  <div class="flex flex-wrap gap-2">
                    {recetteData.produits_recette.map(
                      (produit: { id: string; nom_produit: string }) => (
                        <a
                          href={`/continents/${produit.id}`}
                          class="bg-[var(--color-orange)] bg-opacity-20 text-white px-3 py-1 rounded-full p-body3 hover:bg-opacity-30 transition-colors button"
                        >
                          {produit.nom_produit}
                        </a>
                      )
                    )}
                  </div>
                </div>
              )
          }

          <!-- Boutons d'action -->
          <div class="mt-8 flex flex-wrap gap-4">
            <button
              class="bg-[var(--color-green)] text-[var(--color-blanc)] px-6 py-3 rounded-full hover:opacity-90 transition-all button flex items-center"
              onclick="window.print()"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 mr-2"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
                ></path>
              </svg>
              Imprimer la recette
            </button>

            <button
              class="bg-[var(--color-blanc)] border border-[var(--color-green)] text-[var(--color-green)] px-6 py-3 rounded-full hover:bg-[var(--color-green)] hover:text-[var(--color-blanc)] transition-all button flex items-center"
              onclick="navigator.share ? navigator.share({title: '{recetteData.nom_recette}', url: window.location.href}) : navigator.clipboard.writeText(window.location.href)"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 mr-2"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"
                ></path>
              </svg>
              Partager
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Section ingrédients et préparation -->

    <div class="mt-12 grid md:grid-cols-2 gap-8">
      <!-- Ingrédients -->
      <div class="bg-[var(--color-blanc)] rounded-xl shadow-lg p-8">
        <h2 class="h2-header mb-6 text-[var(--color-noir)] flex items-center">
          <span class="text-2xl mr-3">🥕</span>
          Ingrédients
        </h2>
        <div class="prose prose-sm max-w-none">
          <div set:html={recetteData.ingredients_recette} />
        </div>
      </div>

      <!-- Préparation -->
      <div class="bg-[var(--color-blanc)] rounded-xl shadow-lg p-8">
        <h2 class="h2-header mb-6 text-[var(--color-noir)] flex items-center">
          <span class="text-2xl mr-3">👨‍🍳</span>
          Préparation
        </h2>
        <div class="prose prose-sm max-w-none">
          <div set:html={recetteData.preparation_recette} />
        </div>
      </div>
    </div>

    <!-- Images supplémentaires -->
    {
      recetteData.images_recette && recetteData.images_recette.length > 0 && (
        <div class="mt-12">
          <h2 class="h2-header mb-6 text-[var(--color-noir)] text-center">
            Photos de la recette
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {recetteData.images_recette.map((image, index) => (
              <img
                src={`https://nummy.arthurwicky.fr/api/files/Recette/${recetteData.id}/${image}`}
                alt={`${recetteData.nom_recette} - Image ${index + 1}`}
                class="w-full h-48 object-cover rounded-lg shadow-md hover:shadow-lg transition-shadow cursor-pointer"
                onclick={`window.open(this.src, '_blank')`}
                onerror="this.style.display='none'"
              />
            ))}
          </div>
        </div>
      )
    }

    <!-- Informations sur l'auteur -->
    {
      recetteData.utilisateur_recette && (
        <div class="mt-12 bg-[var(--color-lin)] rounded-xl p-8">
          <h3 class="h3-header mb-4 text-[var(--color-noir)]">
            À propos de l'auteur
          </h3>
          <div class="flex items-center">
            <div class="w-16 h-16 bg-[var(--color-green)] rounded-full flex items-center justify-center text-[var(--color-blanc)] text-xl font-bold mr-4">
              {recetteData.utilisateur_recette.name
                ? recetteData.utilisateur_recette.name.charAt(0).toUpperCase()
                : "U"}
            </div>
            <div>
              <p class="p-body1 font-bold text-[var(--color-noir)]">
                {recetteData.utilisateur_recette.name || "Utilisateur"}
              </p>
              <p class="p-body3 text-[var(--color-green)]">
                Membre de la communauté Nummy
              </p>
            </div>
          </div>
        </div>
      )
    }
  </div>

  <!-- Recettes similaires -->
  {
    recettesSimilaires.length > 0 && (
      <section class="bg-[var(--color-lin)] py-12">
        <div class="px-4 md:px-20">
          <h2 class="h2-header text-center mb-8 text-[var(--color-noir)]">
            Autres recettes de {recetteData.continent_recette}
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
            {recettesSimilaires.map((recette) => (
              <article class="bg-[var(--color-blanc)] rounded-lg shadow border border-[var(--color-lin)] overflow-hidden hover:shadow-lg transition-shadow">
                <img
                  src={
                    recette.hero_recette
                      ? `https://nummy.arthurwicky.fr/api/files/Recette/${recette.id}/${recette.hero_recette}`
                      : "https://via.placeholder.com/400x300?text=Recette"
                  }
                  alt={recette.nom_recette}
                  class="w-full h-40 object-cover"
                />
                <div class="p-4">
                  <h3 class="p-body1 font-bold mb-2 text-[var(--color-noir)]">
                    {recette.nom_recette}
                  </h3>
                  <p class="p-body3 text-[var(--color-green)] mb-3">
                    {recette.pays_recette}
                  </p>
                  <div class="flex justify-between items-center text-[var(--color-green)] p-body3 mb-4">
                    <span>👥 {recette.personnes_recette}</span>
                    <span>⏱️ {recette.temps_recette}min</span>
                  </div>
                  <a
                    href={`/recettes/${recette.id}`}
                    class="inline-block w-full text-center bg-[var(--color-green)] text-[var(--color-blanc)] px-4 py-2 rounded-full hover:opacity-90 transition-all button"
                  >
                    Voir la recette
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Avis et notes -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 mt-10">
    <div class="bg-[var(--color-blanc)] rounded-xl shadow-lg overflow-hidden">
      <div class="p-8">
        <h2 class="h2-header mb-6 text-[var(--color-noir)] flex items-center">
          <span class="text-2xl mr-3"></span>
          Avis et commentaires
        </h2>

        <!-- Statistiques -->
        <div class="bg-[var(--color-lin)] rounded-lg p-6 mb-8">
          <div
            class="flex flex-col md:flex-row items-center justify-between gap-6"
          >
            <div class="text-center">
              <div class="text-4xl font-bold text-[var(--color-orange)]">
                {avisStats.moyenne}
              </div>
              <div class="flex items-center justify-center mt-1">
                {
                  Array.from({ length: 5 }, (_, i) => (
                    <span
                      class={`text-2xl ${i < Math.round(avisStats.moyenne) ? "text-[var(--color-orange)]" : "text-gray-300"}`}
                    >
                      ★
                    </span>
                  ))
                }
              </div>
              <div class="p-body3 text-[var(--color-green)] mt-1">
                {avisStats.total} avis
              </div>
            </div>

            <!-- Répartition -->
            <div class="flex-1 w-full md:ml-8">
              {
                Object.entries(avisStats.repartition)
                  .reverse()
                  .map(([stars, count]) => (
                    <div class="flex items-center mb-2">
                      <span class="p-body3 text-[var(--color-noir)] w-8">
                        {stars}★
                      </span>
                      <div class="flex-1 mx-3 bg-[var(--color-argent)] rounded-full h-2">
                        <div
                          class="bg-[var(--color-orange)] h-2 rounded-full transition-all duration-300"
                          style={`width: ${avisStats.total > 0 ? (count / avisStats.total) * 100 : 0}%`}
                        />
                      </div>
                      <span class="p-body3 text-[var(--color-noir)] w-8">
                        {count}
                      </span>
                    </div>
                  ))
              }
            </div>
          </div>
        </div>

        <!-- formualire d'avis -->

        <div class="bg-[var(--color-lin)] bg-opacity-10 rounded-lg p-6 mb-8">
          <h3 class="h3-header mb-4 text-[var(--color-noir)]">
            Donnez votre avis
          </h3>

          <form id="avis-form" class="space-y-4">
            <input type="hidden" name="recette_id" value={recetteData.id} />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label
                  for="nom_auteur"
                  class="block p-body2 font-bold text-[var(--color-noir)] mb-2"
                  >Votre nom *</label
                >
                <input
                  type="text"
                  id="nom_auteur"
                  name="nom_auteur"
                  required
                  class="w-full px-4 py-3 border bg-white border-[var(--color-orange)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-orange)] p-body2"
                  placeholder="Ex: Marie Dupont"
                />
              </div>

              <div>
                <label
                  for="email_auteur"
                  class="block p-body2 font-bold text-[var(--color-noir)] mb-2"
                  >Votre email *</label
                >
                <input
                  type="email"
                  id="email_auteur"
                  name="email_auteur"
                  required
                  class="w-full px-4 py-3 border bg-white border-[var(--color-orange)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-orange)] p-body2"
                  placeholder="Ex: marie@email.com"
                />
              </div>
            </div>

            <!-- Étoiles -->
            <div>
              <label
                class="block p-body2 font-bold text-[var(--color-noir)] mb-2"
                >Votre note *</label
              >
              <div class="flex space-x-1" id="star-rating">
                {
                  Array.from({ length: 5 }, (_, i) => (
                    <button
                      type="button"
                      data-rating={i + 1}
                      class="star-btn text-6xl text-gray-300 hover:text-[var(--color-orange)] focus:outline-none transition-colors"
                    >
                      ★
                    </button>
                  ))
                }
              </div>
              <input type="hidden" id="note" name="note" required />
            </div>

            <!-- Commentaire -->
            <div>
              <label
                for="commentaire"
                class="block p-body2 font-bold text-[var(--color-noir)] mb-2"
                >Votre commentaire *</label
              >
              <textarea
                id="commentaire"
                name="commentaire"
                required
                rows="4"
                class="w-full px-4 py-3 border bg-white border-[var(--color-orange)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-orange)] p-body2"
                placeholder="Partagez votre expérience avec cette recette..."
              ></textarea>
            </div>

            <!-- Messages -->
            <div
              id="avis-success"
              class="flex justify-center items-center align-middle hidden bg-[var(--color-green)] bg-opacity-20 border border-[var(--color-vert)] text-[var(--color-lin)] px-4 py-3 rounded p-body2"
            >
              Merci ! Votre avis a été publié avec succès.
            </div>

            <div
              id="avis-error"
              class="hidden bg-[var(--color-rouge)] bg-opacity-20 border border-[var(--color-rouge)] text-[var(--color-rouge)] px-4 py-3 rounded p-body2"
            >
              <span id="avis-error-text">Une erreur s'est produite.</span>
            </div>

            <button
              type="submit"
              id="avis-submit"
              class="mt-3 lg:flex justify-center items-center lg:mx-60 w-full lg:w-1/2 bg-[var(--color-orange)] text-[var(--color-blanc)] px-6 py-3 rounded-full hover:opacity-90 transition-all button disabled:opacity-50"
            >
              <span id="avis-submit-text">Publier mon avis</span>
              <span id="avis-submit-loading" class="hidden"
                >Publication en cours...</span
              >
            </button>
          </form>
        </div>

        <div>
          <h3 class="h3-header mb-4 text-[var(--color-noir)]">
            Commentaires ({avisList.length})
          </h3>

          {
            avisList.length > 0 ? (
              <div class="space-y-6">
                {avisList.map((avis) => (
                  <div class="border-b border-[var(--color-lin)] pb-6 last:border-b-0">
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                      <div class="flex items-center space-x-3">
                        <div class="w-12 h-12 bg-[var(--color-orange)] rounded-full flex items-center justify-center text-[var(--color-blanc)] font-bold">
                          {avis.nom_auteur.charAt(0).toUpperCase()}
                        </div>
                        <div>
                          <h4 class="p-body1 font-bold text-[var(--color-noir)]">
                            {avis.nom_auteur}
                          </h4>
                          <div class="flex items-center mt-1">
                            {Array.from({ length: 5 }, (_, i) => (
                              <span
                                class={`text-lg ${i < avis.note ? "text-[var(--color-orange)]" : "text-gray-300"}`}
                              >
                                ★
                              </span>
                            ))}
                          </div>
                        </div>
                      </div>
                      <span class="p-body3 text-white">
                        {new Date(avis.created).toLocaleDateString("fr-FR")}
                      </span>
                    </div>
                    <p class="mt-3 p-body2 text-[var(--color-noir)]">
                      {avis.commentaire}
                    </p>
                  </div>
                ))}
              </div>
            ) : (
              <div class="text-center py-12 text-[var(--color-green)]">
                <div class="text-6xl mb-4">💬</div>
                <p class="p-body1">
                  Aucun avis pour le moment. Soyez le premier à donner votre
                  avis !
                </p>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Banner -->
  <section
    class="bg-gradient-to-r from-[var(--color-green)] to-[var(--color-bleu)] text-[var(--color-blanc)] py-12"
  >
    <div class="px-4 md:px-20 text-center">
      <h2 class="h2-header mb-4">Vous avez aimé cette recette ?</h2>
      <p class="p-body1 mb-6">
        Partagez vos propres créations culinaires avec notre communauté
      </p>
      <div class="space-x-4">
        <a
          href="/recettes/ajouter"
          class="inline-block bg-[var(--color-blanc)] text-[var(--color-green)] px-6 py-3 rounded-full hover:opacity-90 transition-all button"
        >
          Ajouter ma recette
        </a>
        <a
          href="/recettes"
          class="inline-block border-2 border-[var(--color-blanc)] text-[var(--color-blanc)] px-6 py-3 rounded-full hover:bg-[var(--color-blanc)] hover:text-[var(--color-green)] transition-all button"
        >
          Explorer d'autres recettes
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  interface AvisData {
    nom_auteur: string;
    email_auteur: string;
    note: number;
    commentaire: string;
    recette_id: string;
  }

  async function createAvis(avisData: AvisData) {
    try {
      console.log();

      const response = await fetch(
        "https://nummy.arthurwicky.fr/api/collections/Avis/records",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(avisData),
        }
      );

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || "Error en el servidor");
      }

      const result = await response.json();
      console.log();

      return {
        success: true,
        item: result,
      };
    } catch (error) {
      console.error();
      return {
        success: false,
        error: error.message,
      };
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    console.log();

    const stars = document.querySelectorAll(".star-btn");
    const noteInput = document.getElementById("note");
    const form = document.getElementById("avis-form");
    let selectedRating = 0;

    console.log();
    console.log();

    function updateStars() {
      stars.forEach((star, i) => {
        if (i < selectedRating) {
          star.classList.remove("text-gray-300");
          star.classList.add("text-[var(--color-orange)]");
        } else {
          star.classList.remove("text-[var(--color-orange)]");
          star.classList.add("text-gray-300");
        }
      });
    }

    stars.forEach((star, index) => {
      star.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        selectedRating = index + 1;
        noteInput.value = selectedRating;
        updateStars();

        console.log();
      });

      star.addEventListener("mouseenter", () => {
        stars.forEach((s, i) => {
          if (i <= index) {
            s.classList.remove("text-gray-300");
            s.classList.add("text-[var(--color-orange)]");
          } else {
            s.classList.remove("text-[var(--color-orange)]");
            s.classList.add("text-gray-300");
          }
        });
      });
    });

    const starContainer = document.getElementById("star-rating");
    if (starContainer) {
      starContainer.addEventListener("mouseleave", updateStars);
    }

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        console.log();

        if (!selectedRating) {
          showMessage("error", "Veuillez sélectionner une note.");
          return;
        }

        const nom = document.getElementById("nom_auteur").value.trim();
        const email = document.getElementById("email_auteur").value.trim();
        const commentaire = document.getElementById("commentaire").value.trim();

        if (!nom || !email || !commentaire) {
          showMessage("error", "Veuillez remplir tous les champs.");
          return;
        }

        setLoading(true);

        try {
          const avisData = {
            nom_auteur: nom,
            email_auteur: email,
            note: selectedRating,
            commentaire: commentaire,
            recette_id: document.querySelector('input[name="recette_id"]')
              .value,
          };

          console.log();

          const result = await createAvis(avisData);

          if (result.success) {
            showMessage(
              "success",
              "Merci ! Votre avis a été publié avec succès."
            );
            form.reset();
            selectedRating = 0;
            noteInput.value = "";
            updateStars();

            setTimeout(() => {
              window.location.reload();
            }, 2000);
          } else {
            showMessage("error", result.error || "Une erreur s'est produite.");
          }
        } catch (error) {
          console.error(" rror de conexión:", error);
          showMessage("error", "Errer de connexion au serveur.");
        } finally {
          setLoading(false);
        }
      });
    }

    function showMessage(type, text) {
      const successMsg = document.getElementById("avis-success");
      const errorMsg = document.getElementById("avis-error");
      const errorText = document.getElementById("avis-error-text");

      if (successMsg) successMsg.classList.add("hidden");
      if (errorMsg) errorMsg.classList.add("hidden");

      if (type === "success" && successMsg) {
        successMsg.classList.remove("hidden");
      } else if (errorMsg && errorText) {
        errorText.textContent = text;
        errorMsg.classList.remove("hidden");
      }
    }

    function setLoading(loading) {
      const submitBtn = document.getElementById("avis-submit");
      const submitText = document.getElementById("avis-submit-text");
      const submitLoading = document.getElementById("avis-submit-loading");

      if (submitBtn) submitBtn.disabled = loading;
      if (submitText) submitText.classList.toggle("hidden", loading);
      if (submitLoading) submitLoading.classList.toggle("hidden", !loading);
    }
  });
</script>

<style>
  .star-btn {
    user-select: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .star-btn:hover {
    transform: scale(1.1);
  }

  .star-btn:active {
    transform: scale(0.95);
  }
</style>
