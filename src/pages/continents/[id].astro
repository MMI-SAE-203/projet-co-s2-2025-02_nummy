---
import Layout from "../../layouts/Layout.astro";
import { pb, getAllProduits } from "../../js/backend.js";

interface Produit {
  id: string;
  nom_produit: string;
  description_produit: string;
  img_produit?: string;
  pays_produit: string;
  continent_produit: string;
  type_produit?: string;
  site_produit?: string;
  recettes_produit?: string;
  favori_produit: boolean;
  magasin_produit?: any;
}

export async function getStaticPaths() {
  try {
    const allProducts = await getAllProduits();
    return allProducts.map((product) => ({
      params: { id: product.id },
      props: { product },
    }));
  } catch (error) {
    console.error("Error en getStaticPaths:", error);
    return [{ params: { id: "fallback" } }];
  }
}

const { id } = Astro.params;
const { product } = Astro.props;
let produit = product;

if (!produit) {
  try {
    produit = await pb.collection("Produit").getOne(id);
  } catch (error) {
    console.error("Error al obtener el producto:", error);
    return Astro.redirect("/continents");
  }
}

if (id === "fallback") {
  return Astro.redirect("/continents");
}

let produitsSimilaires: Produit[] = [];
try {
  const allProducts = await getAllProduits();
  produitsSimilaires = allProducts
    .filter(
      (p) =>
        p.id !== produit.id && p.continent_produit === produit.continent_produit
    )
    .slice(0, 6);
} catch (error) {
  console.error("Error al obtener productos similares:", error);
}

const imageUrl = produit.img_produit
  ? `https://nummy.arthurwicky.fr/api/files/Produit/${produit.id}/${produit.img_produit}`
  : "https://via.placeholder.com/800x400?text=Nummy";
---

<Layout
  classBody="colorPage colorNav"
  title={`${produit.nom_produit} | Nummy`}
  description={`Découvrez ${produit.nom_produit}, un produit typique de ${produit.pays_produit}`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-24">
    <div class="bg-white rounded-xl shadow-lg overflow-hidden">
      <div class="md:flex">
        <div class="md:flex-shrink-0 md:w-1/2">
          <img
            src={imageUrl}
            loading="lazy"
            alt={produit.nom_produit}
            class="h-full w-full object-cover md:h-full md:w-full max-h-[500px]"
            onerror="this.onerror=null; this.src='https://via.placeholder.com/800x400?text=Nummy';"
          />
        </div>

        <div class="p-8 md:w-1/2">
          <div class="flex items-center">
            <span
              class="inline-flex items-center px-3 py-0.5 rounded-full text-sm font-medium bg-orange-100 text-orange-800 mr-2"
            >
              {produit.continent_produit}
            </span>
            <span
              class="inline-flex items-center px-3 py-0.5 rounded-full text-sm font-medium bg-blue-100 text-blue-800"
            >
              {produit.pays_produit}
            </span>
            {
              produit.favori_produit && (
                <span class="ml-auto text-yellow-400 text-2xl">★</span>
              )
            }
          </div>

          <h1 class="mt-4 text-3xl font-bold text-gray-900 tracking-tight">
            {produit.nom_produit}
          </h1>

          <p
            class="mt-4 text-gray-500 text-lg leading-relaxed"
            set:html={produit.description_produit}
          />

          <div class="mt-8 flex flex-wrap gap-4">
            <!-- debuguer :,3 j'en peux plus  -->

            <!-- <div class="w-full mb-4 bg-yellow-100 p-2 rounded">
              Condición: {produit.site_produit && produit.site_produit.trim() !== '' ? "VERDADERA - Botón debe aparecer" : "FALSA - Botón NO aparece"}
            </div> -->

            {
              produit.site_produit && produit.site_produit.trim() !== "" && (
                <a
                  href={produit.site_produit}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-[var(--color-orange)] hover:bg-orange-300 transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 mr-2"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                  Visiter le site
                </a>
              )
            }
            <a
              href={`https://www.google.com/maps/search/${encodeURIComponent(produit.nom_produit + " " + produit.pays_produit)}`}
              target="_blank"
              class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 shadow-sm text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50"
            >
              Trouver en magasin
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Hmmm délicieux :D / recettes -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Recettes associées</h2>
      <div class="bg-gray-50 rounded-xl p-6">
        {
          produit.recettes_produit ? (
            <div class="prose prose-orange max-w-none">
              <p>{produit.recettes_produit}</p>
            </div>
          ) : (
            <p class="text-gray-500 italic">
              Aucune recette disponible pour ce produit.
            </p>
          )
        }
      </div>
    </div>

    <!-- Productos que se parecenn -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Produits similaires</h2>

      {
        produitsSimilaires.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
            {produitsSimilaires.map((p) => (
              <a href={`/continents/${p.id}`} class="block group">
                <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden h-full flex flex-col transition-transform duration-300 group-hover:shadow-lg group-hover:-translate-y-1">
                  <img
                    src={
                      p.img_produit
                        ? `https://nummy.arthurwicky.fr/api/files/Produit/${p.id}/${p.img_produit}`
                        : "https://via.placeholder.com/400x200?text=Nummy"
                    }
                    alt={p.nom_produit}
                    loading="lazy"
                    class="w-full h-48 object-cover"
                    onerror="this.onerror=null; this.src='https://via.placeholder.com/400x200?text=Nummy';"
                  />
                  <div class="p-4 flex-1 flex flex-col">
                    <h3 class="text-lg font-semibold mb-1">{p.nom_produit}</h3>
                    <p class="text-sm text-gray-500 mb-4">{p.pays_produit}</p>
                    <div class="mt-auto flex justify-between items-center">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                        {p.continent_produit}
                      </span>
                      {p.favori_produit && (
                        <span class="text-yellow-400 text-lg">★</span>
                      )}
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-gray-500 italic">Aucun produit similaire trouvé.</p>
        )
      }
    </div>

    <!-- we are back baby -->
    <div class="mt-12 text-center">
      <a
        href="/continents"
        class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-full shadow-sm text-white bg-[var(--color-orange)] cursor-pointer transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 mr-2"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
            clip-rule="evenodd"></path>
        </svg>
        Retour aux produits
      </a>
    </div>
  </div>
</Layout>
