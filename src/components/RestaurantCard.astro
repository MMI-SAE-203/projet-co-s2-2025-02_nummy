---
export interface Props {
  id: string;
  nom: string;
  adresse: string;
  ville: string;
  categorie: string;
  continent: string;
  image: string;
  partenariat: boolean;
  distance?: number;
  telephone?: string;
}

const {
  id,
  nom,
  adresse,
  ville,
  categorie,
  continent,
  image,
  partenariat,
  distance,
  telephone,
} = Astro.props;

// URL por defecto para cuando las imágenes no cargan
const defaultImageUrl = "https://via.placeholder.com/300x200?text=Nummy";
---

<div
  class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300"
>
  <div class={`flex ${partenariat ? "flex-row" : "flex-col"}`}>
    <!-- Imagen (siempre visible) -->
    <div class={partenariat ? "w-1/3" : "w-full h-48"}>
      <img
        src={image}
        alt={`Photo de ${nom}`}
        class={`${partenariat ? "h-full w-full object-cover" : "w-full h-full object-cover"}`}
        onerror=`this.src='${defaultImageUrl}'; this.onerror=null;`
      />
    </div>

    <!-- Contenido (condicionado según si es partenariat) -->
    <div
      class={`${partenariat ? "w-2/3 p-4 relative bg-[var(--color-lin)]" : "p-4"}`}
    >
      <!-- Etiqueta de partenaire (si aplica) -->
      {
        partenariat && (
          <div class="absolute top-3 right-3 bg-[var(--color-orange)] text-white px-2 py-1 rounded-md text-xs font-semibold">
            Partenaire
          </div>
        )
      }

      <h3 class="text-xl font-semibold mb-1">{nom}</h3>

      <!-- Información adicional (solo para partenaires) -->
      {
        partenariat ? (
          <>
            <div class="flex items-center text-sm text-gray-600 mb-2">
              <span class="mr-2">{categorie}</span>
              <span class="w-1 h-1 bg-gray-400 rounded-full mx-2" />
              <span>{continent}</span>
            </div>
            <p class="text-sm text-gray-700 mb-2">
              {adresse}, {ville}
            </p>
            {telephone && (
              <p class="text-sm text-gray-700 mb-2">Tel: {telephone}</p>
            )}
            {distance !== undefined && (
              <p class="text-sm font-medium text-[var(--color-orange)] mb-3">
                Distance: {distance.toFixed(1)} km
              </p>
            )}

            <a
              href={`/restaurants/${id}`}
              class="inline-block bg-[var(--color-orange)] text-white px-4 py-2 rounded-md hover:bg-opacity-90 transition-colors text-sm"
            >
              Voir plus
            </a>
          </>
        ) : (
          <a
            href={`/restaurants/${id}`}
            class="block mt-2 text-[var(--color-orange)] hover:underline text-sm"
          >
            En savoir plus
          </a>
        )
      }
    </div>
  </div>
</div>
