---
import Layout from "../../layouts/Layout.astro";
import { getAllProduits } from "../../js/backend.js";

const products = await getAllProduits();
---

<Layout classBody="colorPage colorNav" title="Ajouter une recette | Nummy">
  <!-- Header -->
  <div class="bg-gradient-to-t from-[var(--color-orange)] to-orange-300 text-[var(--color-blanc)] p-6 mt-22">
    <h1 class="text-5xl font-light pt-6 -tracking-tighter items-center text-center">
      PARTAGEZ-NOUS  VOS RECETTES !
    </h1>
  </div>

  <!-- Formulaire -->
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <form id="recipe-form" class="bg-white rounded-xl shadow-lg p-8">
      
      <!-- Messages -->
      <div id="success-message" class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
        <strong>Succès !</strong> Votre recette a été ajoutée avec succès.
      </div>
      
      <div id="error-message" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
        <strong>Erreur :</strong> <span id="error-text"></span>
      </div>

      <!-- Informations de base -->
      <div class="mb-8">
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Informations de base</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="nom_recette" class="block text-sm font-medium text-gray-700 mb-2">
              Nom de la recette *
            </label>
            <input
              type="text"
              id="nom_recette"
              name="nom_recette"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
              placeholder="Ex: Couscous traditionnel"
            />
          </div>

          <div>
            <label for="pays_recette" class="block text-sm font-medium text-gray-700 mb-2">
              Pays d'origine *
            </label>
            <input
              type="text"
              id="pays_recette"
              name="pays_recette"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
              placeholder="Ex: Maroc"
            />
          </div>

          <div>
            <label for="continent_recette" class="block text-sm font-medium text-gray-700 mb-2">
              Continent *
            </label>
            <select
              id="continent_recette"
              name="continent_recette"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
            >
              <option value="">Sélectionnez un continent</option>
              <option value="Afrique">Afrique</option>
              <option value="Asie">Asie</option>
              <option value="Europe">Europe</option>
              <option value="Amérique">Amérique du Nord</option>
              <option value="Amérique du Sud">Amérique Latine</option>
              <option value="Océanie">Océanie</option>
            </select>
          </div>

          <div>
            <label for="personnes_recette" class="block text-sm font-medium text-gray-700 mb-2">
              Nombre de personnes *
            </label>
            <input
              type="number"
              id="personnes_recette"
              name="personnes_recette"
              required
              min="1"
              max="20"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
              placeholder="4"
            />
          </div>

          <div>
            <label for="temps_recette" class="block text-sm font-medium text-gray-700 mb-2">
              Temps de préparation (minutes) *
            </label>
            <input
              type="number"
              id="temps_recette"
              name="temps_recette"
              required
              min="5"
              max="600"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
              placeholder="60"
            />
          </div>
        </div>
      </div>

      <!-- Image hero -->
      <div class="mb-8">
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Image principale</h3>
        <div>
          <label for="hero_recette" class="block text-sm font-medium text-gray-700 mb-2">
            Photo de votre recette
          </label>
          <input
            type="file"
            id="hero_recette"
            name="hero_recette"
            accept="image/*"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
          />
          <p class="text-sm text-gray-500 mt-1">Formats acceptés: JPG, PNG, WebP (max 5MB)</p>
        </div>
      </div>

      <!-- Produits -->
      <div class="mb-8">
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Produits utilisés</h3>
        <div>
          <label for="produits_recette" class="block text-sm font-medium text-gray-700 mb-2">
            Sélectionnez les produits (optionnel)
          </label>
          <select
            id="produits_recette"
            name="produits_recette"
            multiple
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 h-32"
          >
            {products.map((product) => (
              <option value={product.id}>
                {product.nom_produit} - {product.pays_produit}
              </option>
            ))}
          </select>
          <p class="text-sm text-gray-500 mt-1">Maintenez Ctrl (Cmd sur Mac) pour sélectionner plusieurs produits</p>
        </div>
      </div>

      <!-- Ingrédients -->
      <div class="mb-8">
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Ingrédients</h3>
        <div>
          <label for="ingredients_recette" class="block text-sm font-medium text-gray-700 mb-2">
            Liste des ingrédients *
          </label>
          <textarea
            id="ingredients_recette"
            name="ingredients_recette"
            required
            rows="8"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
            placeholder="Exemple:
- 500g de semoule de couscous
- 1 kg d'agneau coupé en morceaux
- 3 courgettes
- 2 carottes
- 1 oignon
- Épices ras el hanout
- Sel et poivre"
          ></textarea>
        </div>
      </div>

      <!-- Préparation -->
      <div class="mb-8">
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Préparation</h3>
        <div>
          <label for="preparation_recette" class="block text-sm font-medium text-gray-700 mb-2">
            Étapes de préparation *
          </label>
          <textarea
            id="preparation_recette"
            name="preparation_recette"
            required
            rows="12"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
            placeholder="Décrivez étape par étape comment préparer votre recette:

1. Préparer les légumes...
2. Dans une cocotte, faire revenir...
3. Ajouter les épices...
etc."
          ></textarea>
        </div>
      </div>

      <!-- Images supplémentaires -->
      <div class="mb-8">
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Images supplémentaires</h3>
        <div>
          <label for="images_recette" class="block text-sm font-medium text-gray-700 mb-2">
            Photos des étapes (optionnel)
          </label>
          <input
            type="file"
            id="images_recette"
            name="images_recette"
            accept="image/*"
            multiple
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
          />
          <p class="text-sm text-gray-500 mt-1">Vous pouvez sélectionner plusieurs images</p>
        </div>
      </div>

      <!-- Boutons -->
      <div class="flex justify-end space-x-4">
        <a
          href="/recettes"
          class="px-6 py-3 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors"
        >
          Annuler
        </a>
        <button
          type="submit"
          id="submit-btn"
          class="px-6 button uppercase py-3 bg-[var(--color-orange)] text-white rounded-lg hover:bg-orange-300 transition-colors disabled:opacity-50"
        >
          <span id="submit-text">Ajouter la recette</span>
          <span id="submit-loading" class="hidden">Ajout en cours...</span>
        </button>
      </div>
    </form>
  </div>
</Layout>

<script>
  import { pb } from "../../js/backend.js";

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("recipe-form");
    const submitBtn = document.getElementById("submit-btn");
    const submitText = document.getElementById("submit-text");
    const submitLoading = document.getElementById("submit-loading");
    const successMessage = document.getElementById("success-message");
    const errorMessage = document.getElementById("error-message");
    const errorText = document.getElementById("error-text");

    function showLoading() {
      submitBtn.disabled = true;
      submitText.classList.add("hidden");
      submitLoading.classList.remove("hidden");
    }

    function hideLoading() {
      submitBtn.disabled = false;
      submitText.classList.remove("hidden");
      submitLoading.classList.add("hidden");
    }

    function showSuccess() {
      successMessage.classList.remove("hidden");
      errorMessage.classList.add("hidden");
      // Scroll al top
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function showError(message) {
      errorText.textContent = message;
      errorMessage.classList.remove("hidden");
      successMessage.classList.add("hidden");
      // Scroll al top
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      showLoading();
      
      try {
        // Crear FormData
        const formData = new FormData();
        
        // Campos obligatorios
        formData.append("nom_recette", form.nom_recette.value.trim());
        formData.append("pays_recette", form.pays_recette.value.trim());
        formData.append("continent_recette", form.continent_recette.value);
        formData.append("personnes_recette", form.personnes_recette.value);
        formData.append("temps_recette", form.temps_recette.value);
        formData.append("ingredients_recette", form.ingredients_recette.value.trim());
        formData.append("preparation_recette", form.preparation_recette.value.trim());

        // Imagen hero
        if (form.hero_recette.files[0]) {
          formData.append("hero_recette", form.hero_recette.files[0]);
        }

        // Produits sélectionnés
        const selectedProducts = Array.from(form.produits_recette.selectedOptions).map(option => option.value);
        if (selectedProducts.length > 0) {
          selectedProducts.forEach(productId => {
            formData.append("produits_recette", productId);
          });
        }

        // Images supplémentaires
        if (form.images_recette.files.length > 0) {
          Array.from(form.images_recette.files).forEach(file => {
            formData.append("images_recette", file);
          });
        }

        // Envoyer à PocketBase
        console.log("📤 Envoi de la recette...");
        const record = await pb.collection('Recette').create(formData);
        
        console.log("✅ Recette créée:", record);
        showSuccess();
        
        // Reset formulaire après succès
        setTimeout(() => {
          form.reset();
          successMessage.classList.add("hidden");
        }, 3000);

      } catch (error) {
        console.error("❌ Erreur lors de la création:", error);
        
        let errorMessage = "Une erreur s'est produite lors de l'ajout de la recette.";
        
        if (error.data?.data) {
          const messages = [];
          Object.entries(error.data.data).forEach(([field, fieldError]) => {
            if (fieldError?.message) {
              messages.push(`${field}: ${fieldError.message}`);
            }
          });
          if (messages.length > 0) {
            errorMessage = messages.join(', ');
          }
        } else if (error.message) {
          errorMessage = error.message;
        }
        
        showError(errorMessage);
      } finally {
        hideLoading();
      }
    });
  });
</script>

<style>
  /* Styling pour le multi-select */
  select[multiple] {
    background-image: none;
  }
  
  select[multiple] option:checked {
    background-color: var(--color-orange);
    color: white;
  }
</style>